rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Primitives ---
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    
    // --- Role Helpers ---
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? getUserDoc().data.role : null;
    }
    
    // Using a fallback for bootstrap: if user email is chavhanakash675@gmail.com, they have admin powers.
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'chavhanakash675@gmail.com') ||
        (getUserRole() == 'ADMIN')
      );
    }
    function isEditor() { return isAdmin() || (isSignedIn() && getUserRole() == 'EDITOR'); }
    function isReporter() { return isEditor() || (isSignedIn() && getUserRole() == 'REPORTER'); }

    // --- Entity Validators ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['ADMIN', 'EDITOR', 'REPORTER', 'USER'] &&
             data.createdAt is number &&
             (data.keys().hasAll(['displayName']) ? (data.displayName is string && data.displayName.size() <= 200) : true) &&
             data.uid == request.auth.uid;
    }

    function isValidSource(data) {
      return data.keys().hasAll(['name', 'url', 'type', 'createdAt']) &&
             data.name is string && data.name.size() <= 200 &&
             data.url is string && data.url.size() <= 1000 &&
             data.type in ['RSS', 'SCRAPE'] &&
             data.createdAt is number &&
             (data.keys().hasAll(['category']) ? (data.category is string && data.category.size() <= 100) : true) &&
             (data.keys().hasAll(['isActive']) ? (data.isActive is bool) : true);
    }

    function isValidArticle(data) {
      return data.keys().hasAll(['title', 'summary', 'content', 'status', 'authorId', 'authorName', 'category', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() <= 300 &&
             data.summary is string && data.summary.size() <= 1000 &&
             data.content is string && data.content.size() <= 50000 &&
             data.status in ['DRAFT', 'REVIEW', 'PUBLISHED', 'ARCHIVED'] &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() <= 100 &&
             data.category is string && data.category.size() <= 100 &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (data.keys().hasAll(['district']) ? (data.district is string && data.district.size() <= 100) : true) &&
             (data.keys().hasAll(['taluka']) ? (data.taluka is string && data.taluka.size() <= 100) : true) &&
             (data.keys().hasAll(['village']) ? (data.village is string && data.village.size() <= 100) : true) &&
             (data.keys().hasAll(['tags']) ? (data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string)) : true) &&
             (data.keys().hasAll(['publishedAt']) ? (data.publishedAt is number) : true) &&
             (data.keys().hasAll(['isDeveloping']) ? (data.isDeveloping is bool) : true) &&
             (data.keys().hasAll(['aiGenerated']) ? (data.aiGenerated is bool) : true) &&
             (data.keys().hasAll(['sourceUrl']) ? (data.sourceUrl is string && data.sourceUrl.size() <= 1000) : true) &&
             (data.keys().hasAll(['imageUrl']) ? (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000)) : true) &&
             (data.keys().hasAll(['imagePrompt']) ? (data.imagePrompt is string && data.imagePrompt.size() <= 1000) : true) &&
             (data.keys().hasAll(['imageAlt']) ? (data.imageAlt is string && data.imageAlt.size() <= 300) : true) &&
             (data.keys().hasAll(['requiresHumanReview']) ? (data.requiresHumanReview is bool) : true);
    }

    // --- Collections ---
    
    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isEditor());
      allow list: if isEditor();
      allow create: if isSignedIn() && userId == request.auth.uid &&
                    isValidUser(incoming()) &&
                    ((incoming().role == 'USER') || isAdmin());
      allow update: if isSignedIn() && isValidUser(incoming()) &&
                    incoming().uid == existing().uid &&
                    (
                      isAdmin() || // Admins can update anything
                      (request.auth.uid == userId && incoming().role == existing().role) // Users can update own profile, but NOT role
                    );
      allow delete: if isAdmin();
    }

    // ARTICLES COLLECTION
    match /articles/{articleId} {
      // Public can read published articles. Editors/Reporters can read all.
      allow get: if (resource.data.status == 'PUBLISHED' || isReporter());
      allow list: if resource.data.status == 'PUBLISHED' || isReporter();
      
      // Reporters, Editors, Admins can create.
      allow create: if isSignedIn() && isReporter() &&
                    isValidArticle(incoming()) &&
                    incoming().authorId == request.auth.uid && // Must author it themselves
                    ((incoming().status == 'PUBLISHED' && isEditor()) || incoming().status != 'PUBLISHED'); // Only editors+ can publish directly
      
      // Reporters can update their own drafts. Editors/Admins can update any article.
      allow update: if isSignedIn() && isValidArticle(incoming()) &&
                    (existing().keys().hasAll(['authorId']) == false || incoming().authorId == existing().authorId) && // Author ID is immortal
                    (existing().keys().hasAll(['createdAt']) == false || incoming().createdAt == existing().createdAt) && // CreatedAt is immortal
                    (
                      isEditor() || // Editors can do anything
                      (isReporter() && existing().authorId == request.auth.uid && incoming().status != 'PUBLISHED' && existing().status != 'PUBLISHED') // Reporters can only edit own drafts, cannot publish
                    );
                    
      // Only admins can delete articles. Others should just 'ARCHIVE'.
      allow delete: if isAdmin();
      
      // REVISIONS SUBCOLLECTION
      match /revisions/{revisionId} {
        allow read: if isReporter();
        allow write: if isEditor(); // Only Editors/Admins (or the backend automator) can save revisions
      }
    }

    // SOURCES COLLECTION
    match /sources/{sourceId} {
      allow read: if true;
      allow create: if isAdmin() && isValidSource(incoming());
      allow update: if isAdmin() && isValidSource(incoming());
      allow delete: if isAdmin();
    }
  }
}

