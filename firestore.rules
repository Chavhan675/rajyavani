rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Primitives ---
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    
    // --- Role Helpers ---
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? getUserDoc().data.role : null;
    }
    
    // Super Admin / Owner check
    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'chavhanakash675@gmail.com') ||
        (request.auth.token.email == 'admin@rajyavani.com') ||
        (getUserRole() == 'SUPER_ADMIN') ||
        (getUserRole() == 'ADMIN')
      );
    }
    
    function isAdmin() { return isSuperAdmin(); }
    function isEditor() { return isSuperAdmin(); }
    function isReporter() { return isSuperAdmin(); }

    // --- Entity Validators ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['SUPER_ADMIN', 'ADMIN', 'USER'] &&
             data.createdAt is number &&
             (data.keys().hasAll(['displayName']) ? (data.displayName == null || (data.displayName is string && data.displayName.size() <= 200)) : true) &&
             (data.keys().hasAll(['photoURL']) ? (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000)) : true) &&
             (data.keys().hasAll(['preferredDistrict']) ? (data.preferredDistrict == null || (data.preferredDistrict is string && data.preferredDistrict.size() <= 100)) : true) &&
             (data.keys().hasAll(['preferredCategory']) ? (data.preferredCategory == null || (data.preferredCategory is string && data.preferredCategory.size() <= 100)) : true) &&
             (data.keys().hasAll(['isSuspended']) ? (data.isSuspended is bool) : true) &&
             (data.keys().hasAll(['bookmarks']) ? (data.bookmarks is list) : true) &&
             data.uid == request.auth.uid;
    }

    function isValidSource(data) {
      return data.keys().hasAll(['name', 'url', 'type', 'createdAt']) &&
             data.name is string && data.name.size() <= 200 &&
             data.url is string && data.url.size() <= 1000 &&
             data.type in ['RSS', 'SCRAPE'] &&
             data.createdAt is number &&
             (data.keys().hasAll(['category']) ? (data.category is string && data.category.size() <= 100) : true) &&
             (data.keys().hasAll(['isActive']) ? (data.isActive is bool) : true);
    }

    function isValidArticle(data) {
      return data.keys().hasAll(['title', 'summary', 'content', 'status', 'authorId', 'authorName', 'category', 'createdAt', 'updatedAt']) &&
             data.title is string && data.title.size() <= 300 &&
             data.summary is string && data.summary.size() <= 1000 &&
             data.content is string && data.content.size() <= 50000 &&
             data.status in ['DRAFT', 'REVIEW', 'PUBLISHED', 'ARCHIVED'] &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() <= 100 &&
             data.category is string && data.category.size() <= 100 &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (data.keys().hasAll(['district']) ? (data.district is string && data.district.size() <= 100) : true) &&
             (data.keys().hasAll(['taluka']) ? (data.taluka is string && data.taluka.size() <= 100) : true) &&
             (data.keys().hasAll(['village']) ? (data.village is string && data.village.size() <= 100) : true) &&
             (data.keys().hasAll(['tags']) ? (data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string)) : true) &&
             (data.keys().hasAll(['publishedAt']) ? (data.publishedAt is number) : true) &&
             (data.keys().hasAll(['isDeveloping']) ? (data.isDeveloping is bool) : true) &&
             (data.keys().hasAll(['aiGenerated']) ? (data.aiGenerated is bool) : true) &&
             (data.keys().hasAll(['sourceUrl']) ? (data.sourceUrl is string && data.sourceUrl.size() <= 1000) : true) &&
             (data.keys().hasAll(['imageUrl']) ? (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000)) : true) &&
             (data.keys().hasAll(['imagePrompt']) ? (data.imagePrompt is string && data.imagePrompt.size() <= 1000) : true) &&
             (data.keys().hasAll(['imageAlt']) ? (data.imageAlt is string && data.imageAlt.size() <= 300) : true) &&
             (data.keys().hasAll(['requiresHumanReview']) ? (data.requiresHumanReview is bool) : true);
    }

    // --- Collections ---
    
    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && userId == request.auth.uid &&
                    isValidUser(incoming()) &&
                    ((incoming().role == 'USER') || isSuperAdmin());
      allow update: if isSignedIn() &&
                    (
                      isSuperAdmin() || // Super admin can modify any user (role, suspend status)
                      (request.auth.uid == userId && incoming().role == existing().role) // Users can update profile, but not elevate own role
                    );
      allow delete: if isSuperAdmin();
    }

    // AUTH AUDIT LOGS
    match /auth_audit_logs/{logId} {
      allow create: if true; // Allows logging both successful and failed attempts
      allow read, list: if isSuperAdmin();
      allow update, delete: if false; // Immutable audit log
    }

    // ARTICLES COLLECTION
    match /articles/{articleId} {
      // Public can read published articles. Super Admin can read all.
      allow get: if (resource.data.status == 'PUBLISHED' || isSuperAdmin());
      allow list: if resource.data.status == 'PUBLISHED' || isSuperAdmin();
      
      // Super Admin can create, edit, approve, publish, update, delete
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
      
      // REVISIONS SUBCOLLECTION
      match /revisions/{revisionId} {
        allow read, write: if isSuperAdmin();
      }
    }

    // SOURCES COLLECTION
    match /sources/{sourceId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // SITE SETTINGS
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }
  }
}

